# Conexão com o Postgres (Neon). Crie o projeto em https://neon.tech e copie a
# connection string do seu banco aqui.
DATABASE_URL=postgres://user:senha@ep-algo.neon.tech/nagalli?sslmode=require

# Segredo usado para assinar os tokens de login. Use uma string longa e aleatoria.
JWT_SECRET=troque-por-uma-string-longa-e-secreta

# Porta do servidor (padrao 3000)
PORT=3000
